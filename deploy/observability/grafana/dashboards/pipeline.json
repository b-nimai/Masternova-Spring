        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(pipeline_job_seconds_count{application=\"worker\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
