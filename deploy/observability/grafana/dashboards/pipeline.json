    {
      "id": 13,
      "type": "timeseries",
      "title": "Job duration p95 by step (finished jobs)",
      "description": "TRANSCODE is one rung each: the 1080p rung dominates.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, job_type) (rate(pipeline_job_seconds_bucket{application=\"worker\", outcome=\"done\"}[$__rate_interval])))",
          "legendFormat": "{{job_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
