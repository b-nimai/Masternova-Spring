{
  "uid": "mn-slo",
  "title": "SLOs & error budgets",
  "description": "The three SLOs of D3.5: burn rate (1 = spending exactly the 30-day budget), what's left of the budget, and what's firing. Rules: deploy/observability/prometheus/rules/.",
  "tags": [
    "masternova",
    "slo"
  ],
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "graphTooltip": 1,
  "links": [
    {
      "title": "Masternova",
      "type": "dashboards",
      "tags": [
        "masternova"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Error budget left (30 days)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Availability \u2014 99.5 % no 5xx",
      "description": "Share of the 30-day error budget not yet spent (negative = SLO missed). Red under 25 %.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - ((sum(increase(http_server_requests_seconds_count{application=\"api\", uri!~\"/actuator.*|.*/stream\", status=~\"5..\"}[30d])) or vector(0)) / sum(increase(http_server_requests_seconds_count{application=\"api\", uri!~\"/actuator.*|.*/stream\"}[30d]))) / 0.005",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latency \u2014 95 % under 300 ms",
      "description": "Share of the 30-day error budget not yet spent (negative = SLO missed). Red under 25 %.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (1 - sum(increase(http_server_requests_seconds_bucket{application=\"api\", uri!~\"/actuator.*|.*/stream\", le=\"0.3\"}[30d])) / sum(increase(http_server_requests_seconds_count{application=\"api\", uri!~\"/actuator.*|.*/stream\"}[30d]))) / 0.05",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Outbox \u2014 99 % handled within 60 s",
      "description": "Share of the 30-day error budget not yet spent (negative = SLO missed). Red under 25 %.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
