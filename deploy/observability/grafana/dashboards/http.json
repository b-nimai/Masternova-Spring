        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"api\", instance=~\"$instance\", uri!~\"/actuator.*|.*/stream\", status=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
