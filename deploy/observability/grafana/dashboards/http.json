      }
    },
    {
      "id": 15,
      "type": "table",
      "title": "Slowest routes (p95, last 1 h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{application=\"api\", instance=~\"$instance\", uri!~\"/actuator.*|.*/stream\"}[1h]))))",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true
        }
