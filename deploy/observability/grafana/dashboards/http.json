          },
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_sum{application=\"api\", instance=~\"$instance\", uri!~\"/actuator.*|.*/stream\"}[$__rate_interval])) / sum by (method, uri) (rate(http_server_requests_seconds_count{application=\"api\", instance=~\"$instance\", uri!~\"/actuator.*|.*/stream\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{uri}}"
