    {
      "id": 12,
      "type": "timeseries",
      "title": "GC pause time per second",
      "description": "Fraction of wall-clock time spent paused. Above ~5 % the app is fighting its heap.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
