# Copy to .env only if you need to override defaults. Every key has a working default in
# application.yaml for the local compose stack, so a fresh clone runs with no .env at all.

# --- database (api + worker) ---
DATABASE_URL=jdbc:postgresql://localhost:5433/masternova
DATABASE_USER=masternova
DATABASE_PASSWORD=masternova

# --- redis ---
REDIS_HOST=localhost
REDIS_PORT=6380

# --- ports ---
API_PORT=8080
WORKER_PORT=8090

# --- mail (worker → mailpit in dev) ---
SMTP_HOST=localhost
SMTP_PORT=1026

# --- added by later phases ---
# JWT_ACCESS_SECRET=            # Phase 3 identity
# S3_ENDPOINT= S3_BUCKET=       # Phase 7 media
# RAZORPAY_KEY_ID= RAZORPAY_KEY_SECRET= RAZORPAY_WEBHOOK_SECRET=   # Phase 9 commerce
# PLAYBACK_TOKEN_SECRET=        # Phase 8 entitlement
