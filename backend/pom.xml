<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		Parent POM for the Masternova backend.
		Inherits Spring Boot's dependency + plugin management, adds the Spring Modulith BOM,
		and owns every plugin version so the modules stay declarative.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>com.masternova</groupId>
	<artifactId>masternova-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>masternova-backend</name>
	<description>Masternova EdTech platform — Spring Boot modular monolith + worker</description>

	<modules>
		<module>kernel</module>
		<module>messaging</module>
		<module>api</module>
		<module>worker</module>
	</modules>

	<properties>
		<java.version>25</java.version>
		<spring-modulith.version>2.1.1</spring-modulith.version>
		<spotless.version>3.10.3</spotless.version>
		<!-- 1.36+ adds a commonmark dependency Spotless 3.10 fails to load; bump when Spotless fixes it. -->
		<google-java-format.version>1.35.0</google-java-format.version>
		<jacoco.version>0.8.15</jacoco.version>
		<!-- coverage floors (0.00–1.00); each module may raise its own -->
		<coverage.line>0.00</coverage.line>
		<coverage.branch>0.00</coverage.branch>

		<!--
			Security overrides of versions Spring Boot manages (found by Trivy in CI).
			Remove each one once a Boot release ships the same or newer version.
		-->
		<tomcat.version>11.0.26</tomcat.version>
		<jackson-bom.version>3.1.7</jackson-bom.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.masternova</groupId>
				<artifactId>kernel</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.masternova</groupId>
				<artifactId>messaging</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.modulith</groupId>
				<artifactId>spring-modulith-bom</artifactId>
				<version>${spring-modulith.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.jacoco</groupId>
					<artifactId>jacoco-maven-plugin</artifactId>
					<version>${jacoco.version}</version>
				</plugin>
				<plugin>
					<groupId>com.diffplug.spotless</groupId>
					<artifactId>spotless-maven-plugin</artifactId>
					<version>${spotless.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<!-- Formatting: `./mvnw spotless:apply` fixes, `verify` fails on unformatted code. -->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<configuration>
					<java>
						<googleJavaFormat>
							<version>${google-java-format.version}</version>
						</googleJavaFormat>
						<removeUnusedImports/>
					</java>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
						<phase>verify</phase>
					</execution>
				</executions>
			</plugin>

			<!--
				Coverage (patterns/devops/04 §5): unit tests (jacoco.exec) and Testcontainers ITs
				(jacoco-it.exec) are MERGED, the report and the gate read the merge. The gate fails
				`verify` below the module's floor (properties coverage.line / coverage.branch).
			-->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>prepare-agent-it</id>
						<goals>
							<goal>prepare-agent-integration</goal>
						</goals>
					</execution>
					<execution>
						<id>merge</id>
						<phase>verify</phase>
						<goals>
							<goal>merge</goal>
						</goals>
						<configuration>
							<fileSets>
								<fileSet>
									<directory>${project.build.directory}</directory>
									<includes>
										<include>jacoco.exec</include>
										<include>jacoco-it.exec</include>
									</includes>
								</fileSet>
							</fileSets>
							<destFile>${project.build.directory}/jacoco-merged.exec</destFile>
						</configuration>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
						<configuration>
							<dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
						</configuration>
					</execution>
					<execution>
						<id>check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>${coverage.line}</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>${coverage.branch}</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
