<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		Shared kernel: plain Java, no Spring. Holds what both deployables (api, worker) agree on —
		the @DesignPattern marker today; event contracts, outbox and idempotency types from Phase 2.
	-->
	<parent>
		<groupId>com.masternova</groupId>
		<artifactId>masternova-backend</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>kernel</artifactId>
	<name>kernel</name>

	<properties>
		<!-- measured 51 % lines / 81 % branches on 2026-10-02 (mostly annotation/enum declarations) -->
		<coverage.line>0.45</coverage.line>
		<coverage.branch>0.75</coverage.branch>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-launcher</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
